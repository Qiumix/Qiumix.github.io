#import "/templates/post.typ": post

#let args = (
  title: "Hello World —— Typst Test",
  date: "2026-07-17", // YYYY-MM-DD
  update: "2026-07-19", // 更新日期（可选）
  summary: "第一篇博客，测试Typst",
  author: "Qiumix", // 默认取 tola.toml 的 author
  draft: false, // true = 不发布
  tags: ("hello", "blog", "typst"), // 标签数组
  // === 链接相关 ===
  // permalink: "/test-url/", // 自定义永久链接（可选）
  // aliases: ("/old-url/",), // URL 别名，自动生成重定向（可选）
  // === 布局控制 ===
  global-header: true, // false = 不注入全局样式/脚本（404 页用）
  outline: true, // false = 隐藏目录
  // === 自定义字段（随意加） ===
  pinned: false, // 置顶
  series: "系列名", // 归属系列
  reading-time: 5, // 阅读时间（分钟）
  order: 1, // 排序序号
  featured: false, // 精选
  domain: "programming", // 领域分类
  page-kind: "post", // 页面种类（"series" 表示系列封面）
  todo: false, // 待完成标记
  next: none, // 手动指定下一篇（用 pages() 查）
  prev: none, // 手动指定上一篇（用 pages() 查）
)
#show: post.with(..args)

= 文本样式

*斜体* 和 _强调_ 和 ==划重点== 和 ~~删除线~~ 和 `行内代码`

也可以用 #emph[强调] 和 #strong[加粗] 和 #underline[下划线] 函数。

