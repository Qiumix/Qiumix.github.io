= 代码

行内代码: 使用 `println("hello")` 输出。

代码块（带语法高亮）:

```python
def hello(name):
    print(f"Hello, {name}!")

class Greeter:
    def __init__(self, name):
        self.name = name
    def greet(self):
        return f"Hello, {self.name}!"

g = Greeter("World")
print(g.greet())
```

```rust
fn main() {
    let msg = "Hello, World!";
    println!("{}", msg);

    let nums = vec![1, 2, 3, 4, 5];
    let sum: i32 = nums.iter().sum();
    println!("Sum: {}", sum);
}
```

```javascript
function fibonacci(n) {
  if (n <= 1) return n
  return fibonacci(n - 1) + fibonacci(n - 2)
}

const arr = [1, 2, 3, 4, 5]
const doubled = arr.map(x => x * 2)
console.log(doubled)
```

```typst
#let factorial(n) = {
  if n <= 1 { 1 } else { n * factorial(n - 1) }
}

#for i in range(5) {
  [#i! = #factorial(i)]
}
```

```json
{
  "name": "Typst",
  "version": "0.12.0",
  "features": ["markup", "scripting", "typesetting"]
}
```

